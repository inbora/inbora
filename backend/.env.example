# Copy to backend/.env for local development. On Render, set these as
# environment variables on the inbora-api service.

# Supabase → Project Settings → Data API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase → Project Settings → API Keys → service_role (secret!)
SUPABASE_SERVICE_ROLE_KEY=
# Only if your project uses the legacy JWT secret (Settings → JWT Keys).
# Leave empty for projects using JWT signing keys.
SUPABASE_JWT_SECRET=

# Where the web panel runs (CORS). Comma-separated for several.
WEB_URL=http://localhost:3000

# Google AI Studio → API key
GEMINI_API_KEY=
# Optional: models tried in order (comma-separated)
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3-flash-preview

# Links in alert emails and notifications point here
APP_URL=http://localhost:3000

# Alerts to the team (Step 4) — each is skipped while empty.
# Resend → API Keys (inbora.ai must be a verified sending domain)
RESEND_API_KEY=
# ALERTS_FROM=Inbora <alerts@inbora.ai>
# Browser notifications: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@inbora.ai

# WhatsApp, Instagram (Step 5) and email (Step 6): a Zernio account used only
# for Inbora. Zernio → API Keys, and the secret you set on the Zernio webhook.
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
# How often every mailbox is also read, in seconds, in case a webhook is missed
# EMAIL_POLL_SECONDS=180

# Hours without a team reply before the agent takes a conversation back
# HANDBACK_HOURS=1

# true = the background worker runs inside the API process
EMBEDDED_WORKER=true
