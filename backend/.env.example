# Copy to backend/.env for local development. On Render, set these as
# environment variables on the inbora-api service.

# Supabase → Project Settings → Data API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase → Project Settings → API Keys → service_role (secret!)
SUPABASE_SERVICE_ROLE_KEY=
# Only if your project uses the legacy JWT secret (Settings → JWT Keys).
# Leave empty for projects using JWT signing keys.
SUPABASE_JWT_SECRET=

# Where the web panel runs (CORS). Comma-separated for several.
WEB_URL=http://localhost:3000

# Google AI Studio → API key (used from Step 2)
GEMINI_API_KEY=
