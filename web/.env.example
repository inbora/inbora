# Copy to web/.env.local for local development. On Render, set these on the
# inbora-web service. NEXT_PUBLIC_* values are baked in at build time, so
# redeploy after changing them.

# Supabase → Project Settings → Data API (URL) and API Keys (anon / publishable)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Inbora API (FastAPI service)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Where this panel is served — used in email confirmation links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
